{
  "name": "cley-cooe-studio",
  "version": "1.0.1",
  "description": "CLEY COOE Studio - aplicativo auxiliar para organizar salas e eventos do Club Cooee",
  "main": "electron/main.cjs",
  "author": "CLEY COOE",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.cleycooe.studio",
    "productName": "CLEY COOE Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "electron/**/*",
      "package.json",
      "pwa-assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CLEY COOE Studio"
    }
  }
}
